# Dependencies & build output
node_modules/
# One Astro build per version (.build/), then the merged site (dist/).
.build/
dist/
# Docs sources fetched from git branches (scripts/lib/content-source.ts).
.cache/
.astro/
# The package pages are content: keep them even though their folder is called packages/.
!versions/*/packages/

# Environment & secrets: never commit
.env
.env.*
!.env.example

# Docker: local development only, never committed (ADR-0006)
docker/
Dockerfile*
.dockerignore
compose.yaml
compose.*.yaml
docker-compose*.yml
docker-compose*.yaml

# Logs, OS and editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: personal, machine-local settings
.claude/settings.local.json
