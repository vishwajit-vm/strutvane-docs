{
  "name": "strutvane-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Strutvane documentation site: versioned docs (one Starlight build per version), deployed to GitHub Pages.",
  "license": "MIT AND CC-BY-4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts && node scripts/v1-redirects.mjs",
    "preview": "node scripts/preview.ts",
    "check:links": "node scripts/check-links.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc --noEmit -p . && node --test \"test/*.test.ts\"",
    "verify": "npm run build && npm run check:links && npm test",
    "packages:pages": "node scripts/package-pages.ts",
    "sync": "node scripts/sync-from-hub.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.13",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
